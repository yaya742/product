# 本地开发默认使用 open_meteo。
WEATHER_PROVIDER=open_meteo

# 正式环境可设置 WEATHER_PROVIDER=qweather。
# 请填写和风天气控制台提供的专用 API Host。
QWEATHER_API_HOST=https://your-api-host
QWEATHER_API_KEY=replace-me

DEFAULT_TIMEZONE=Asia/Shanghai
WEATHER_REQUEST_TIMEOUT=8
WEATHER_CURRENT_CACHE_TTL=300
WEATHER_FORECAST_CACHE_TTL=1800
