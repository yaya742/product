# open_meteo is the default for local development.
WEATHER_PROVIDER=open_meteo

# Set WEATHER_PROVIDER=qweather for production use.
# Use the dedicated API Host from the QWeather console.
QWEATHER_API_HOST=https://your-api-host
QWEATHER_API_KEY=replace-me

DEFAULT_TIMEZONE=Asia/Shanghai
WEATHER_REQUEST_TIMEOUT=8
WEATHER_CURRENT_CACHE_TTL=300
WEATHER_FORECAST_CACHE_TTL=1800
