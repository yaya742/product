{
  "apiVersion": 1,
  "id": "weather",
  "version": "1.1.0",
  "displayName": "天气",
  "description": "通过宿主受控网络通道读取天气、逐小时预报和户外活动建议。",
  "entry": "index.mjs",
  "capabilities": [
    {
      "name": "weather.lookup",
      "displayName": "查询天气",
      "description": "读取指定地点的当前天气和未来几天预报。",
      "version": "1.0.0",
      "effect": "read",
      "requiredScopes": ["weather:read"],
      "subjects": ["self"],
      "worlds": ["real"],
      "timeoutMs": 15000,
      "maxBytes": 80000,
      "supportsIdempotency": false,
      "supportsInspect": false,
      "supportsCancel": false,
      "inputSchema": {
        "type": "object",
        "required": ["days", "location"],
        "properties": {
          "days": { "type": "integer", "minimum": 1, "maximum": 7 },
          "location": { "type": "string", "enum": ["current", "Hangzhou"] },
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
          "locationLabel": { "type": "string", "maxLength": 160 },
          "locationSource": { "type": "string", "enum": ["windows_location", "manual", "reference"] },
          "accuracy_m": { "type": "number", "minimum": 0, "maximum": 100000 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["location", "timeZone", "current", "forecast"],
        "properties": {
          "location": { "type": "string" },
          "timeZone": { "type": "string" },
          "current": {
            "type": "object",
            "required": ["temperature_2m", "apparent_temperature", "relative_humidity_2m", "precipitation", "weather_code", "wind_speed_10m", "is_day"],
            "properties": {
              "temperature_2m": { "type": "number" },
              "apparent_temperature": { "type": "number" },
              "relative_humidity_2m": { "type": "number", "minimum": 0, "maximum": 100 },
              "precipitation": { "type": "number", "minimum": 0 },
              "weather_code": { "type": "integer", "minimum": 0 },
              "wind_speed_10m": { "type": "number", "minimum": 0 },
              "is_day": { "type": "integer", "enum": [0, 1] }
            },
            "additionalProperties": false
          },
          "forecast": {
            "type": "object",
            "required": ["time", "weather_code", "temperature_2m_max", "temperature_2m_min", "precipitation_probability_max"],
            "properties": {
              "time": { "type": "array", "items": { "type": "string" } },
              "weather_code": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
              "temperature_2m_max": { "type": "array", "items": { "type": "number" } },
              "temperature_2m_min": { "type": "array", "items": { "type": "number" } },
              "precipitation_probability_max": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 100 } }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "weather.forecast",
      "displayName": "逐小时天气",
      "description": "读取指定地点未来一段时间的逐小时天气。",
      "version": "1.0.0",
      "effect": "read",
      "requiredScopes": ["weather:read"],
      "subjects": ["self"],
      "worlds": ["real"],
      "timeoutMs": 15000,
      "maxBytes": 100000,
      "supportsIdempotency": false,
      "supportsInspect": false,
      "supportsCancel": false,
      "inputSchema": {
        "type": "object",
        "required": ["hours"],
        "properties": {
          "hours": { "type": "integer", "minimum": 1, "maximum": 240 },
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
          "timeZone": { "type": "string", "maxLength": 100 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["location", "timeZone", "hourly"],
        "properties": {
          "location": { "type": "string" },
          "timeZone": { "type": "string" },
          "hourly": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "weather.outdoor_activity",
      "displayName": "户外活动建议",
      "description": "基于降水、温度和风速给出户外活动建议，并明确不确定性。",
      "version": "1.0.0",
      "effect": "read",
      "requiredScopes": ["weather:read"],
      "subjects": ["self"],
      "worlds": ["real"],
      "timeoutMs": 15000,
      "maxBytes": 80000,
      "supportsIdempotency": false,
      "supportsInspect": false,
      "supportsCancel": false,
      "inputSchema": {
        "type": "object",
        "required": ["hours"],
        "properties": {
          "hours": { "type": "integer", "minimum": 1, "maximum": 48 },
          "activity": { "type": "string", "maxLength": 80 },
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
          "timeZone": { "type": "string", "maxLength": 100 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["activity", "status", "statusText", "reasons"],
        "properties": {
          "activity": { "type": "string" },
          "status": { "type": "string", "enum": ["go", "caution", "avoid", "unknown"] },
          "statusText": { "type": "string" },
          "reasons": { "type": "array", "items": { "type": "string" } },
          "window": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  ],
  "egressHosts": ["api.open-meteo.com"],
  "platforms": ["win32", "darwin", "linux"],
  "offline": "unsupported",
  "license": "MIT"
}
