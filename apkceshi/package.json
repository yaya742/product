{
  "name": "zaichang-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "在场移动端本地 Agent：手机直连用户自己的 DeepSeek API Key",
  "scripts": {
    "dev": "vite",
    "dev:vm": "vite --open /?mobileVm=1",
    "build": "tsc --noEmit && vite build && vite build --config vite.background.config.ts",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "aes-js": "^3.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
